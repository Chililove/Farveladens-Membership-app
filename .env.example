# =============================================================================
#  ENVIRONMENT VARIABLES (template) — copy to .env and fill in real values
# =============================================================================
#  This .example file is safe to commit (no real secrets). Your real .env is
#  gitignored and never pushed.

# --- Database (Prisma Postgres) ---
DATABASE_URL="postgres://..."

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="your-generated-secret"
# Your Resend API key (sending access) — from resend.com
AUTH_RESEND_KEY="re_your_resend_key"
# Optional: the "from" address for login emails. Needs a verified domain in
# Resend; until then Auth.js uses onboarding@resend.dev.
# AUTH_EMAIL_FROM="no-reply@your-domain.dk"

# --- Membership config ---
# The MobilePay number members transfer their dues to (kept out of the code).
PAYMENT_MOBILEPAY_NUMBER="123456"

# --- Admin digest (fortnightly summary email) ---
# Shared secret for the cron route. Vercel sends it automatically as a Bearer
# token once this is set in the project. Generate with: openssl rand -hex 32
CRON_SECRET="your-generated-secret"
# Optional. Leave unset and the digest goes to every ADMIN in the database,
# which is what the forening will want. Set it while Resend is in test mode,
# since only the Resend account owner's address can receive mail.
# Comma-separate for several recipients.
# ADMIN_DIGEST_EMAIL="you@example.com"

# --- Demo mode ---
# Set to "false" to hide the "Try as member/admin" buttons on the login page.
# DEMO_MODE="false"
