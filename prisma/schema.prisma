// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js adapter tables (User, Account, Session, VerificationToken).
// Membership-specific fields live on User below.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  role                Role      @default(MEMBER)
  membershipExpiresAt DateTime?
  rulesAcceptedAt     DateTime? // when the member accepted the rules (null = not yet)
  // Demo accounts and anything a demo visitor creates. Wiped on each demo
  // login and excluded from the board's digest.
  isDemo              Boolean   @default(false)
  payments            Payment[]
  bookings            Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Payment {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amountDkk   Int // whole kroner
  periodEnd   DateTime // membership runs until this date once confirmed
  method      PaymentMethod @default(MOBILEPAY)
  status      PaymentStatus @default(PENDING)
  reference   String?
  createdAt   DateTime      @default(now())
  confirmedAt DateTime?
}

// A member's reservation of the studio or the stage. Times are stored in UTC;
// the app converts to and from Danish time (Europe/Copenhagen) at the edges.
model Booking {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  room      Room
  startsAt  DateTime
  endsAt    DateTime
  note      String? // optional "what for", e.g. "band rehearsal"
  createdAt DateTime @default(now())

  @@index([room, startsAt])
}

enum Room {
  STUDIO
  STAGE
}

enum Role {
  MEMBER
  ADMIN
}

enum PaymentMethod {
  MOBILEPAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
}
